{
  "name": "geometry-td-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint:html": "htmlhint \"*.html\"",
    "lint:css": "stylelint \"src/**/*.css\"",
    "check-all": "npm run type-check && npm run lint:html && npm run lint:css"
  },
  "devDependencies": {
    "htmlhint": "^1.9.2",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  },
  "dependencies": {
    "pixi.js": "^8.18.1"
  }
}
